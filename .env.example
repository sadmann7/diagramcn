# Database (optional: change tracking is disabled without it)
# Local: `pnpm db:start` runs Postgres in Docker with the values below.
# Production: the PlanetScale Postgres connection string.
DATABASE_URL="postgresql://postgres:password@localhost:5432/diagramcn"

DATABASE_USER="postgres"
DATABASE_PASSWORD="password"
DATABASE_NAME="diagramcn"
DATABASE_PORT="5432"

# Authenticates the daily crawl cron (Vercel sends it as a bearer token).
# Generate with `openssl rand -hex 32`.
CRON_SECRET=""

{
  "name": "@diagramcn/root",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev -F @diagramcn/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm check-types",
    "clean": "rimraf --glob **/node_modules **/dist **/.next **/.turbo **/*.tsbuildinfo",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:generate": "turbo run db:generate -F @diagramcn/db",
    "db:push": "turbo run db:push -F @diagramcn/db",
    "db:migrate": "turbo run db:migrate -F @diagramcn/db",
    "db:studio": "turbo run db:studio -F @diagramcn/db",
    "crawl": "pnpm -F @diagramcn/web crawl",
    "cli": "tsx packages/cli/src/index.ts",
    "cli:build": "turbo run build -F diagramcn"
  },
  "devDependencies": {
    "@diagramcn/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "rimraf": "^6.1.3",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.5.1"
}
